flowchart TD
    classDef source fill:#1e293b,stroke:#a1a1aa,stroke-width:1px,color:#f8fafc;
    classDef crypto fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef storage fill:#0f172a,stroke:#10b981,stroke-width:2px,color:#f8fafc;

    subgraph Compilation [1. Code Generation]
        fwBin["Firmware Binary File<br/>(Embedded_IoT_v1.0.0-dev2.bin)"]
    end

    subgraph Signing [2. Digital Signature Generation]
        shaCompute["SHA-256 Hashing Algorithm"]
        hashResult["32-Byte Hash Digest<br/>(Unique Fingerprint)"]
        ecdsaSign["ECDSA SECP256R1 Signer"]
        privateKey["Developer Private Key<br/>(signing.key)"]
        targetSignature["target_signature<br/>(Hex-encoded Seal)"]
    end

    subgraph Database [3. Manifest Update]
        manifestJson["manifest.json Database<br/>(Updates & Patches Catalog)"]
    end

    fwBin -- "Feeds raw binary bytes" --> shaCompute
    shaCompute -- "Calculates fingerprint" --> hashResult
    hashResult -- "Feeds message digest input" --> ecdsaSign
    privateKey -- "Encrypts hash digest" --> ecdsaSign
    ecdsaSign -- "Outputs signature seal" --> targetSignature

    targetSignature -- "Registered as verification metadata" --> manifestJson
    fwBin -- "Stored on disk storage directory" --> manifestJson

    class fwBin source;
    class shaCompute,hashResult,ecdsaSign,privateKey,targetSignature crypto;
    class manifestJson storage;

%% Diagram 4: Client-Side Transport & Flash Writing Flow
%% Purpose: data streaming, decompression, and memory writing steps on the ESP32.
flowchart TD
    A["Receive presigned URL<br/>from handshake response"] --> B["Open TLS Connection<br/>Symmetric Cryptography session<br/>negotiated after handshake"]:::transport

    B --> C["Stream binary in chunks<br/>fixed-size packets, written<br/>incrementally (no full RAM buffer)"]:::transport

    C --> D{"isDelta flag set?"}

    D -->|"true"| E["Delta Update / Patch<br/>apply binary diff algorithm<br/>against currently running image"]:::delta
    D -->|"false"| F["Full Update<br/>write complete new image<br/>byte-for-byte"]:::full

    E --> G["In-place Decompression<br/>reconstruct full image from<br/>patch + running firmware"]:::write
    F --> G

    G --> H["Raw Flash Write<br/>to A/B Dual-Bank Partition<br/>staging slot (inactive bank)"]:::write

    H --> I["Staging slot populated<br/>active/running bank untouched"]:::write

    classDef transport fill:#E6F1FB,stroke:#185FA5,color:#042C53
    classDef delta fill:#EEEDFE,stroke:#534AB7,color:#26215C
    classDef full fill:#FAECE7,stroke:#993C1D,color:#4A1B0C
    classDef write fill:#E1F5EE,stroke:#0F6E56,color:#04342C

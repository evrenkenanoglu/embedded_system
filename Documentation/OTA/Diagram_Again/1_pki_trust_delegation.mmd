%% Diagram 1: Trust Delegation & PKI Setup Flow
%% Purpose: how trust is established at the factory before any device ships.
flowchart TD
    A["Generate Root CA<br/>ca.key + ca.crt<br/>(offline, factory-only)"]:::root

    A -->|"ca.crt (public)"| B["Embed as Trust Anchor<br/>ca.crt hardcoded into<br/>ESP32 firmware image"]:::anchor
    A -->|"ca.key (private)<br/>used for Key Delegation"| C["Sign Developer Certificate<br/>ca.key issues a subordinate cert"]:::delegate

    B --> D["ESP32 Firmware Build<br/>Trust Anchor baked in,<br/>flashed to every device"]:::anchor
    C --> E["Developer Certificate Pair<br/>signing.crt (public)<br/>signing.key (private)"]:::delegate

    D -.->|"used later to verify"| F(("Certificate Chain<br/>validated at boot"))
    E -.->|"used later to sign"| G(("Firmware releases"))

    classDef root fill:#EEEDFE,stroke:#534AB7,color:#26215C
    classDef anchor fill:#E1F5EE,stroke:#0F6E56,color:#04342C
    classDef delegate fill:#FAECE7,stroke:#993C1D,color:#4A1B0C

%% Diagram 5: Client-Side Certificate Validation & Cryptographic Signature Checks
%% Purpose: mathematical security verification gates before boot redirection.
flowchart TD
    A["Staged partition write complete<br/>(from Diagram 4)"] --> B["Load signing.crt<br/>from manifest metadata<br/>received in handshake"]

    B --> C{"Verify Certificate Chain<br/>via mbedTLS:<br/>signing.crt signed by ca.crt?"}

    C -->|"Chain invalid"| C1["Reject update<br/>abort, keep running current bank"]:::fail
    C -->|"Chain valid"| D["Extract Developer Public Key<br/>from the now-trusted signing.crt"]:::keys

    D --> E["Hash Written Partition<br/>SHA-256 over exactly<br/>target_size bytes (no more, no less)"]:::hash

    E --> F{"ECDSA Signature Validation<br/>verify(hash, public_key, target_signature)"}

    F -->|"Invalid signature"| F1["Reject update<br/>staged image discarded"]:::fail
    F -->|"Valid signature"| G["Mark staged partition bootable<br/>set A/B boot pointer"]:::pass

    G --> H["Reboot into new firmware"]:::pass

    classDef fail fill:#FCEBEB,stroke:#A32D2D,color:#501313
    classDef keys fill:#EEEDFE,stroke:#534AB7,color:#26215C
    classDef hash fill:#E1F5EE,stroke:#0F6E56,color:#04342C
    classDef pass fill:#EAF3DE,stroke:#3B6D11,color:#173404

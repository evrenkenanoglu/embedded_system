flowchart TD
    classDef request fill:#1e293b,stroke:#a1a1aa,stroke-width:1px,color:#f8fafc;
    classDef gate fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef decision fill:#1e293b,stroke:#f59e0b,stroke-width:1px,color:#f8fafc;
    classDef abort fill:#0f172a,stroke:#ef4444,stroke-width:1px,color:#f8fafc;
    classDef proceed fill:#0f172a,stroke:#10b981,stroke-width:2px,color:#f8fafc;

    subgraph Handshake [1. Incoming Query Verification]
        query["Client Query to /api/v1/ota/check<br/>(Headers: API-Key, Version, HW, MAC, Channel, HSVN)"]
        authCheck{"Is Device API Key<br/>Authorized?"}
        hwCheck{"Does Client Hardware<br/>match Manifest Device?"}
    end

    subgraph Policy [2. Version, Anti-Rollback & Rollout Gates]
        verCheck{"Is latest_version > client_version?"}
        hsvnCheck{"Is client_hsvn <= target_hsvn?"}
        canaryCheck{"Is Device ID within<br/>Canary rollout percentage?"}
    end

    subgraph Resolution [3. Update Payload Determination]
        deltaCheck{"Is delta patch built for<br/>client's current version?"}
        routeDelta["Build Delta Payload<br/>(Set isDelta = True, target_size & patch_sig)"]
        routeFull["Build Full Payload<br/>(Set isDelta = False, target_size & full_sig)"]
    end

    err401(["Return 401 Unauthorized"])
    err400(["Return 400 Bad Request"])
    noUpdate(["Return 200: Update Available = False"])
    hsvnAbort(["Return 200: Anti-rollback Protection Active"])
    successOta(["Return 200 OK with Update JSON & Presigned Token"])

    query --> authCheck
    authCheck -- "No" --> err401
    authCheck -- "Yes" --> hwCheck
    
    hwCheck -- "No" --> err400
    hwCheck -- "Yes" --> verCheck

    verCheck -- "No" --> noUpdate
    verCheck -- "Yes" --> hsvnCheck

    hsvnCheck -- "No" --> hsvnAbort
    hsvnCheck -- "Yes" --> canaryCheck

    canaryCheck -- "No" --> noUpdate
    canaryCheck -- "Yes" --> deltaCheck

    deltaCheck -- "Yes" --> routeDelta
    deltaCheck -- "No" --> routeFull

    routeDelta --> successOta
    routeFull --> successOta

    class query,routeDelta,routeFull request;
    class authCheck,hwCheck,verCheck,hsvnCheck,canaryCheck,deltaCheck decision;
    class err401,err400,noUpdate,hsvnAbort abort;
    class successOta proceed;
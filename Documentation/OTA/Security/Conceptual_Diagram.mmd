flowchart TD
    classDef setup fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef server fill:#1e293b,stroke:#a1a1aa,stroke-width:1px,color:#f8fafc;
    classDef client fill:#1e293b,stroke:#3b82f6,stroke-width:1px,color:#f8fafc;
    classDef decision fill:#1e293b,stroke:#f59e0b,stroke-width:1px,color:#f8fafc;
    classDef endpoint fill:#0f172a,stroke:#ef4444,stroke-width:1px,color:#f8fafc;
    classDef success fill:#0f172a,stroke:#10b981,stroke-width:2px,color:#f8fafc;

    subgraph Stage1 [1. Trust Delegation & PKI Setup]
        RootCA["Root CA ca.crt / ca.key<br/>(Master Trust Anchor)"]
        DevKeys["Developer signing.key / signing.crt<br/>(Delegated Keys)"]
        ESP_Trust["ESP32 Client ROM/Flash<br/>(Contains ca.crt)"]
        
        RootCA -- "Signs & Issues with Root Private Key" --> DevKeys
        RootCA -- "Embeds ca.crt trust anchor at factory" --> ESP_Trust
    end

    subgraph Stage2 [2. Server-Side Code Signing]
        FW["Firmware Binary<br/>(Compiled .bin)"]
        SHA_S["SHA-256 Hashing"]
        HashS["32-Byte Hash Digest"]
        Signer["ECDSA SECP256R1 Signer"]
        PrivKey["signing.key<br/>(Private Key)"]
        Sig["target_signature<br/>(Signature Seal)"]

        FW -- "Feeds raw binary bytes" --> SHA_S
        SHA_S -- "Generates 32-byte digest" --> HashS
        HashS -- "Feeds message digest input" --> Signer
        PrivKey -- "Provides ECDSA SECP256R1 key" --> Signer
        Signer -- "Creates hex-encoded signature" --> Sig
    end

    subgraph Stage3 [3. Client-Side Integrity & Verification]
        Payload["Incoming JSON Payload<br/>(signing.crt, target_signature, target_size, Firmware)"]
        CertCheck{"Verify signing.crt<br/>against ca.crt"}
        ExtractKey["Extract Developer<br/>Public Key"]
        CalcHash["Read Firmware up to target_size<br/>& Compute SHA-256 Hash"]
        Verify{"Verify Signature<br/>(mbedtls_pk_verify)"}
        SwitchBoot["Set Boot Partition & Restart"]
        AbortUpdate["Abort & Wipe Partition"]

        Payload -- "Parses 'signing_cert'" --> CertCheck
        CertCheck -- "Valid (mbedtls_x509_crt_verify == 0)" --> ExtractKey
        CertCheck -- "Invalid (Chain Verification Failed)" --> AbortUpdate
        
        Payload -- "Reassembles binary via esp_delta_ota" --> CalcHash
        
        ExtractKey -- "Passes extracted mbedtls_pk_context" --> Verify
        CalcHash -- "Feeds 32-byte calculated hash" --> Verify
        Payload -- "Passes received hex target_signature" --> Verify
        
        Verify -- "Authentic (mbedtls_pk_verify == 0)" --> SwitchBoot
        Verify -- "Failed (mbedtls_pk_verify != 0)" --> AbortUpdate
    end

    Sig -. "Transmitted in JSON" .-> Payload
    FW -. "Streamed via HTTP" .-> Payload
    DevKeys -. "signing.crt included in manifest" .-> Payload

    class RootCA,DevKeys,ESP_Trust setup;
    class FW,SHA_S,HashS,Signer,PrivKey,Sig server;
    class Payload,ExtractKey,CalcHash client;
    class CertCheck,Verify decision;
    class AbortUpdate endpoint;
    class SwitchBoot success;
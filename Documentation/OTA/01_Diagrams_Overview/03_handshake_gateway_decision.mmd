%% Diagram 3: Dynamic Handshake & Gateways Decision Flow
%% Purpose: exact decision-tree logic executed by the server during an update query.
flowchart TD
    A["GET /update<br/>request arrives with<br/>diagnostic client headers<br/>(device ID, current version, HSVN, chip type)"] --> B{"API Key valid?"}

    B -->|"No"| B1["401 Unauthorized<br/>reject request"]:::fail
    B -->|"Yes"| C{"Release Channel valid?<br/>(stable / beta / dev)"}

    C -->|"No match"| C1["404 No release<br/>on this channel"]:::fail
    C -->|"Match found"| D{"Anti-Rollback check<br/>client HSVN < target HSVN?"}

    D -->|"target HSVN <= client HSVN"| D1["Block update<br/>refuse to serve an equal<br/>or older secure version number"]:::fail
    D -->|"target HSVN > client HSVN"| E{"Canary Rollout check<br/>MD5(device_id) mod 100<br/>within rollout %?"}

    E -->|"Outside rollout bucket"| E1["204 No update yet<br/>device not in this wave"]:::hold
    E -->|"Inside rollout bucket"| F["Generate Presigned Token<br/>time-limited signed URL<br/>for the binary download"]:::pass

    F --> G["200 OK<br/>respond with manifest entry<br/>+ presigned download URL"]:::pass

    classDef fail fill:#FCEBEB,stroke:#A32D2D,color:#501313
    classDef hold fill:#F1EFE8,stroke:#5F5E5A,color:#2C2C2A
    classDef pass fill:#E1F5EE,stroke:#0F6E56,color:#04342C

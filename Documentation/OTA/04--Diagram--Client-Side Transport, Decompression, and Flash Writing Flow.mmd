flowchart TD
    classDef transport fill:#1e293b,stroke:#a1a1aa,stroke-width:1px,color:#f8fafc;
    classDef write fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef decision fill:#1e293b,stroke:#f59e0b,stroke-width:1px,color:#f8fafc;
    classDef abort fill:#0f172a,stroke:#ef4444,stroke-width:1px,color:#f8fafc;
    classDef success fill:#0f172a,stroke:#10b981,stroke-width:2px,color:#f8fafc;

    subgraph StreamInit [1. Connection & Stream Setup]
        urlParse["Parse Transient URL & Expiry Token"]
        connectHost["Establish Secure TLS Tunnel<br/>(HttpsClient::connect)"]
        getStream["Send HTTP GET Request to Server<br/>(OtaHttpTransport::startStream)"]
        checkHTTP{"HTTP Response == 200 OK?"}
    end

    subgraph PartitionInit [2. Flash Allocation Setup]
        memInit["Initialize OTA Driver Partition Map<br/>(mem_ota::init)"]
        setMode["Configure Write Mode: setDeltaMode isDelta"]
        beginFlash["Erase Staging Boot Slot & Begin Session<br/>(mem_ota::begin)"]
    end

    subgraph StreamLoop [3. Data Write Loop]
        readChunk["Receive 8KB Data Chunk from TLS Stream"]
        modeCheck{"isDelta == true?"}
        writeDelta["esp_delta_ota_feed_patch<br/>(Decompress & apply delta in-place)"]
        writeFull["esp_ota_write<br/>(Write raw bytes directly to partition)"]
        chunkCheck{"All chunks received?"}
    end

    errStreamAbort(["Return ERROR_FAIL (Abort update)"])
    successStream(["Finalize Flash Write Session (esp_ota_end)"])

    urlParse --> connectHost
    connectHost --> getStream
    getStream --> checkHTTP
    
    checkHTTP -- "No" --> errStreamAbort
    checkHTTP -- "Yes" --> memInit

    memInit --> setMode
    setMode --> beginFlash
    beginFlash --> readChunk

    readChunk --> modeCheck
    modeCheck -- "Yes" --> writeDelta
    modeCheck -- "No" --> writeFull

    writeDelta --> chunkCheck
    writeFull --> chunkCheck

    chunkCheck -- "No" --> readChunk
    chunkCheck -- "Yes" --> successStream

    class urlParse,connectHost,getStream transport;
    class memInit,setMode,beginFlash,readChunk,writeDelta,writeFull write;
    class checkHTTP,modeCheck,chunkCheck decision;
    class errStreamAbort abort;
    class successStream success;
flowchart TD
    classDef start_end fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef step fill:#1e293b,stroke:#64748b,stroke-width:1px,color:#f8fafc;
    classDef decision fill:#1e293b,stroke:#f59e0b,stroke-width:1px,color:#f8fafc;
    classDef err fill:#1e293b,stroke:#ef4444,stroke-width:1px,color:#f8fafc;
    classDef success fill:#1e293b,stroke:#10b981,stroke-width:1px,color:#f8fafc;

    Start([Receive POST /api/v1/ota/status]) --> Auth{X-Device-API-Key == API_KEY?}
    Auth -- No --> Ret401([Return 401 Unauthorized])
    Auth -- Yes --> SanitizePath[Sanitize device_id: replace colons with dashes<br/>F4:12:FA:40:67:30 -> F4-12-FA-40-67-30]
    SanitizePath --> WriteLog[Append telemetry payload to device_F4-12-FA-40-67-30.json]
    WriteLog --> ScanLogs[Scan all telemetry_logs/*.json for target_version]
    ScanLogs --> AggregateMetrics[Aggregate metrics: successes count, failures count]
    AggregateMetrics --> CheckReportsThreshold{Total Reports >= MIN_STATUS_REPORTS_FOR_ROLLBACK?}
    CheckReportsThreshold -- No --> Ret200Ok([Return 200 OK Recorded])
    CheckReportsThreshold -- Yes --> CalculateRate[Calculate Failure Rate = failures / total * 100]
    CalculateRate --> CheckFailureThreshold{Failure Rate >= MAX_FAILURE_RATE_PERCENT?}
    CheckFailureThreshold -- No --> Ret200Ok
    CheckFailureThreshold -- Yes --> LogRollback[Log CRITICAL Auto-Rollback Alert]
    
    LogRollback --> OpenManifest[Read current manifest.json]
    OpenManifest --> SoftRollbackUpdate[Update target version status to soft-rolled-back]
    SoftRollbackUpdate --> FindStableVersion[Find latest active, non-failed version in same channel]
    FindStableVersion --> RevertChannelLatest[Point active channel latest_version to previous stable version]
    RevertChannelLatest --> SaveManifestAtomically[Atomically save manifest:<br/>Write manifest.json.tmp -> Replace manifest.json]
    SaveManifestAtomically --> WarnRollbackComplete[Log WARNING Rollback Completed]
    WarnRollbackComplete --> Ret200Ok

    class Start,Ret401,Ret200Ok start_end;
    class SanitizePath,WriteLog,ScanLogs,AggregateMetrics,CalculateRate,LogRollback,OpenManifest,SoftRollbackUpdate,FindStableVersion,RevertChannelLatest,SaveManifestAtomically,WarnRollbackComplete step;
    class Auth,CheckReportsThreshold,CheckFailureThreshold decision;
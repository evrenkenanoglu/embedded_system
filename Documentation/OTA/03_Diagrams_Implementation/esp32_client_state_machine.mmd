flowchart TD
    classDef start_end fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef step fill:#1e293b,stroke:#64748b,stroke-width:1px,color:#f8fafc;
    classDef decision fill:#1e293b,stroke:#f59e0b,stroke-width:1px,color:#f8fafc;
    classDef err fill:#1e293b,stroke:#ef4444,stroke-width:1px,color:#f8fafc;
    classDef success fill:#1e293b,stroke:#10b981,stroke-width:1px,color:#f8fafc;

    Start[Start Task: AppTestRoutine] --> Init[Initialize wifi, mem_ota & cpx_credentials]
    Init --> ConnectWifi[Establish Wi-Fi AP Link]
    ConnectWifi --> FetchMetadata[Fetch Dynamic MAC Address & Compiled App Description]
    
    subgraph Phase1 [Phase 1 Gateway Handshake]
        FetchMetadata --> PrepHeaders[Prepare HTTP GET Request Headers:<br/>API-Key, Version, HW-ID, Device-ID, Channel, HSVN]
        PrepHeaders --> SendCheck[Send GET Request to /api/v1/ota/check]
        SendCheck --> CheckHTTPStatus{HTTP Status == 200?}
        CheckHTTPStatus -- No --> LogFail[Log HTTP Mismatch Error]
        CheckHTTPStatus -- Yes --> ParseJSON[Parse JSON Metadata with cJSON]
        ParseJSON --> CheckUpdate{update_available == true?}
        CheckUpdate -- No --> Sleep[Terminate Task & Sleep]
        CheckUpdate -- Yes --> ExtractParams[Extract: url, isDelta, signature,<br/>target_signature, target_size, signing_cert]
    end

    subgraph Phase2 [Phase 2 Secure Transport Decompression and Storage]
        ExtractParams --> VerifySignCert{Verify signing_cert against ca.crt<br/>via mbedtls_x509_crt_verify}
        VerifySignCert -- Invalid --> ReportFailCert[Send Telemetry Report: failure]
        VerifySignCert -- Valid --> SetWriteMode[Configure flash mode: setDeltaMode isDelta]
        SetWriteMode --> InitStream[Initialize OtaHttpTransport with transient signed URL]
        InitStream --> ExecStream[Execute otaService.startUpdate]
        ExecStream --> StreamLoop[Process incoming chunks from socket]
        StreamLoop --> WriteLoop{isDelta == true?}
        WriteLoop -- Yes --> FeedDelta[esp_delta_ota_feed_patch<br/>decompress & write to raw partition]
        WriteLoop -- No --> FeedFull[esp_ota_write<br/>write full binary directly]
        FeedDelta --> EndStream{Data stream complete?}
        FeedFull --> EndStream
        EndStream -- No/Error --> ReportFailDownload[Send Telemetry Report: failure]
        EndStream -- Yes --> FinalizeFlash[Finalize partition write: esp_ota_end]
    end

    subgraph Phase3 [Phase 3 Cryptographic Integrity Verification]
        FinalizeFlash --> BlockHash[Calculate progressive SHA-256 Hash of partition<br/>Constrained strictly to target_size]
        BlockHash --> VerifySignature{Verify computed hash against target_signature<br/>using public key from signing_cert}
        VerifySignature -- Invalid --> ErasePart[Erase partition & abort update]
        VerifySignature -- Valid --> SetBoot[Set active boot partition: esp_ota_set_boot_partition]
        SetBoot --> ReportSuccess[Send Telemetry Report: success]
        ReportSuccess --> Restart[Execute esp_restart]
    end

    LogFail --> DeleteTask
    ReportFailCert --> DeleteTask
    ReportFailDownload --> DeleteTask
    ErasePart --> ReportFailSig[Send Telemetry Report: failure]
    ReportFailSig --> DeleteTask
    Restart --> DeleteTask
    DeleteTask[vTaskDelete NULL]

    class Start,Sleep,DeleteTask start_end;
    class Init,ConnectWifi,FetchMetadata,PrepHeaders,SendCheck,ParseJSON,ExtractParams,SetWriteMode,InitStream,ExecStream,StreamLoop,FeedDelta,FeedFull,FinalizeFlash,BlockHash,SetBoot,ReportSuccess,ReportFailCert,ReportFailDownload,ReportFailSig,ErasePart,LogFail,Restart step;
    class CheckHTTPStatus,CheckUpdate,VerifySignCert,WriteLoop,EndStream,VerifySignature decision;

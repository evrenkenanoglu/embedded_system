flowchart TD
    classDef start_end fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef step fill:#1e293b,stroke:#64748b,stroke-width:1px,color:#f8fafc;
    classDef decision fill:#1e293b,stroke:#f59e0b,stroke-width:1px,color:#f8fafc;
    classDef err fill:#1e293b,stroke:#ef4444,stroke-width:1px,color:#f8fafc;
    classDef success fill:#1e293b,stroke:#10b981,stroke-width:1px,color:#f8fafc;

    Start([Receive GET /api/v1/ota/check]) --> Auth{X-Device-API-Key == API_KEY?}
    Auth -- No --> Ret401([Return 401 Unauthorized])
    Auth -- Yes --> ExtractHeaders[Extract: version, hardware, device_id, channel, hsvn]
    ExtractHeaders --> CheckHW{client_hardware == manifest.hardware_device?}
    CheckHW -- No --> Ret400([Return 400 Bad Request])
    CheckHW -- Yes --> GetChannelHead[Query latest_version for requested channel in manifest.json]
    GetChannelHead --> CompareVer{latest_version > client_version?}
    CompareVer -- No --> RetNoUpdate([Return update_available: false])
    CompareVer -- Yes --> GetVersionInfo[Retrieve target update metadata dictionary]
    GetVersionInfo --> CheckHSVN{client_hsvn <= target_hsvn?}
    CheckHSVN -- No --> RetHsvnAbort([Return update_available: false, message: Anti-Rollback Blocked])
    CheckHSVN -- Yes --> CanaryEval{Run Deterministic Canary Check:<br/>MD5 device_id + ":" + version % 100 < canary_percentage?}
    CanaryEval -- No --> RetNoCanary([Return update_available: false, message: Bypassed by Canary])
    CanaryEval -- Yes --> EvalDelta{Is client_version present in updates.patches?}
    
    EvalDelta -- Yes --> RouteDelta[Map to target delta patch binary<br/>Size = patch_size, Hash = patch_hash, Sig = patch_signature]
    RouteDelta --> SignTokenDelta[Generate dynamic transient download token for patch filename]
    SignTokenDelta --> BuildResponseDelta[Construct JSON response:<br/>update_type: delta, target_size: full_size, target_signature: full_sig]
    BuildResponseDelta --> Ret200Delta([Return 200 OK with Delta Update JSON])

    EvalDelta -- No --> RouteFull[Map to complete firmware binary<br/>Size = full_size, Hash = full_hash, Sig = full_sig]
    RouteFull --> SignTokenFull[Generate dynamic transient download token for full filename]
    SignTokenFull --> BuildResponseFull[Construct JSON response:<br/>update_type: full, target_size: full_size, target_signature: full_sig]
    BuildResponseFull --> Ret200Full([Return 200 OK with Full Update JSON])

    class Start,Ret401,Ret400,RetNoUpdate,RetHsvnAbort,RetNoCanary,Ret200Delta,Ret200Full start_end;
    class ExtractHeaders,GetChannelHead,GetVersionInfo,RouteDelta,SignTokenDelta,BuildResponseDelta,RouteFull,SignTokenFull,BuildResponseFull step;
    class Auth,CheckHW,CompareVer,CheckHSVN,CanaryEval,EvalDelta decision;

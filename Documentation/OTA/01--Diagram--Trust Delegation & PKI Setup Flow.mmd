flowchart TD
    classDef ca fill:#1e293b,stroke:#ef4444,stroke-width:2px,color:#f8fafc;
    classDef dev fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef device fill:#0f172a,stroke:#10b981,stroke-width:2px,color:#f8fafc;

    subgraph Authority [1. Master Trust Authority Generation]
        caKey["Root CA Private Key (ca.key)<br/>Kept offline and secure"]
        caCert["Root CA Certificate (ca.crt)<br/>Master Trust Anchor"]
        caKey -- "Self-signs" --> caCert
    end

    subgraph Delegation [2. Developer Key Delegation]
        devKey["Developer Private Key (signing.key)<br/>Stored securely on Developer Server"]
        devCert["Developer Certificate (signing.crt)<br/>Binds Developer Public Key to identity"]
    end

    subgraph ESP32 [3. Target Device Manufacturing]
        espFlash["ESP32 Flash Memory<br/>Pre-programmed Trust Anchor"]
    end

    caKey -- "Signs and issues" --> devCert
    caCert -- "Embedded in firmware build" --> espFlash

    class caKey,caCert ca;
    class devKey,devCert dev;
    class espFlash device;